<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".OpenRtveApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenRTVE"
        android:usesCleartextTraffic="false"
        tools:targetApi="n">

        <!-- El vídeo se ve apaisado aunque el móvil tenga la rotación bloqueada, como en
             cualquier app de vídeo; el catálogo no se fuerza. En tablets y plegables
             Android 16 ignora la orientación pedida y la ventana sigue siendo adaptable. -->
        <activity
            android:name=".playback.PlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            tools:ignore="DiscouragedApi"
            tools:targetApi="o" />

        <!-- Única entrada de la app, pensada para Android TV: su checklist exige landscape.
             No hay filtros VIEW ni SEND: un enlace externo abriría contenido ajeno a Clan. -->
        <activity
            android:name=".ui.tv.TvActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenRTVE.Launcher"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Algunas teles y cajas Android sin Leanback solo listan las apps con LAUNCHER. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 exige que el servicio sea visible para controladores externos;
             MediaSession valida cada conexión en tiempo de ejecución. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>
